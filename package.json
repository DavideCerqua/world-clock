{
  "name": "world-clock-project",
  "version": "1.0.0",
  "description": "A customizable world clock dashboard with an interactive timezone map.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
